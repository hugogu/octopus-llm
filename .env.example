# Copy this file to `.env` and adjust values for your local development environment.

# -----------------------------------------------------------------------------
# Docker image registry prefix and per-image overrides
# -----------------------------------------------------------------------------
# Public Docker Hub mirrors are increasingly unreliable in China Mainland:
# some have whitelists, others rate-limit or drop tags. The RECOMMENDED solution
# is to use a private mirror from a Chinese cloud vendor, or pull images while
# on a VPN, then retag them locally.
#
# If all your images happen to be on one mirror, set a global prefix:
#   DOCKER_IMAGE_PREFIX=docker.m.daocloud.io/
#
# For finer control, override individual images. These take precedence over
# DOCKER_IMAGE_PREFIX. Below is a combination known to work from China Mainland
# at one point (mirrors change over time):
#
#   DB_IMAGE=docker.m.daocloud.io/postgres:16.6-alpine
#   MAILHOG_IMAGE=hub.rat.dev/mailhog/mailhog:v1.0.1
#   PLANTUML_IMAGE=docker.m.daocloud.io/plantuml/plantuml-server:jetty-v1.2026.6
#   BACKEND_BUILDER_IMAGE=docker.m.daocloud.io/gradle:8.8-jdk21-jammy
#   BACKEND_RUNNER_IMAGE=docker.m.daocloud.io/eclipse-temurin:21-jre-alpine
#   FRONTEND_NODE_IMAGE=docker.m.daocloud.io/node:20-alpine
#
# If you leave everything empty, images are pulled directly from Docker Hub.
DOCKER_IMAGE_PREFIX=
DB_IMAGE=
MAILHOG_IMAGE=
PLANTUML_IMAGE=
MINIO_IMAGE=
BACKEND_BUILDER_IMAGE=
BACKEND_RUNNER_IMAGE=
FRONTEND_NODE_IMAGE=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_NAME=octopus_llm
DB_USER=octopus
DB_PASSWORD=octopus

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
# 32-byte AES-256 master key, base64-encoded. Generate with: openssl rand -base64 32
# The value below is a throwaway dev default — replace it for any real deployment.
ENCRYPTION_MASTER_KEY=Y2hhbmdlLW1lLXBsZWFzZS0zMmJ5dGUtZGV2LWtleSE=
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_EXPIRY_SECONDS=3600
ADMIN_BOOTSTRAP_EMAIL=
TRUSTED_PROXIES=
ANONYMOUS_VISITOR_HMAC_SECRET=local-development-anonymous-visitor-secret

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MailHog
# -----------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# -----------------------------------------------------------------------------
# Optional: S3/OSS-compatible object store (minio) for media storage development
# -----------------------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Optional: external services
# -----------------------------------------------------------------------------
PLANTUML_SERVER_URL=http://plantuml:8080
PLANTUML_MAX_SOURCE_BYTES=102400
OPENROUTER_API_KEY=
MEDIA_LOCAL_DIR=/app/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
# Built-in web_search tool (feature 009). Leave WEB_SEARCH_API_KEY empty to disable the tool; when set,
# any function-calling model can call web_search (covers news/stock/weather). Backed by a MiMo-style
# provider that runs the search server-side.
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
WEB_SEARCH_MODEL=mimo-v2.5-pro
