# Database
DB_NAME=octopus_llm
DB_USER=octopus
DB_PASSWORD=changeme

# Encryption — 32-byte base64-encoded AES-256 master key
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# JWT — HS256 secret, at least 64 random characters
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600

# Mail (local dev: Mailhog defaults)
MAIL_HOST=localhost
MAIL_PORT=1025

# Frontend URL (used for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Next.js public API base URL (consumed by the browser)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Exposed ports (optional overrides)
BACKEND_PORT=8080
FRONTEND_PORT=3000
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
